# Environment Variables for ajinsunnywebsite
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT: After renaming server-only vars (removing NEXT_PUBLIC_ prefix),
# update your actual environment variables in AWS Amplify (or .env.local)
# to use the new names listed below.

# Client-side (exposed to browser — NEXT_PUBLIC_ prefix required)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=    # Google reCAPTCHA v3 site key

# Server-only (never sent to browser — no NEXT_PUBLIC_ prefix)
RECAPTCHA_SECRET_KEY=              # Google reCAPTCHA v3 secret key
SES_SMTP_USER=                     # AWS SES SMTP username
SES_SMTP_PASSWORD=                 # AWS SES SMTP password
RECEIVER_EMAIL=                    # Email address to receive contact form submissions
